<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <TargetFramework>net10.0</TargetFramework>
        <SelfContained>true</SelfContained>
        <UseAppHost>true</UseAppHost>
        <PublishAot>true</PublishAot>
        <PublishTrimmed>true</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
        <!-- The host BFD linker may only support x64, even with an Arm32 toolchain installed. -->
        <LinkerFlavor Condition="'$(RuntimeIdentifier)' == 'linux-arm' and '$(LinkerFlavor)' == ''">lld</LinkerFlavor>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
        <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    </PropertyGroup>
</Project>
